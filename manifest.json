{
    "name": "kibaco-advance",
    "author": "@aya172957",
    "description": "課題提出時にPDFのプレビューを表示させる拡張機能, お知らせと時間割も復活させる．資料の一括ダウンロードにも対応．",
    "version": "2.1.4",
    "manifest_version": 3,
    "icons": {
        "16": "icon/icon16.png",
        "48": "icon/icon48.png",
        "128": "icon/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://kibaco.tmu.ac.jp/portal/*"
            ],
            "js": [
                "preview.js",
                "notification.js",
                "timetable.js"
            ]
        },
        {
            "matches": [
                "https://kibaco.tmu.ac.jp/portal/*"
            ],
            "css": [
                "preview.css",
                "timetablestyle.css"
            ]
        },
        {
            "matches": [
                "https://kibaco.tmu.ac.jp/portal/site/*/tool/*"
            ],
            "js": [
                "jszip.min.js",
                "zip-downloader.js"
            ],
            "run_at": "document_idle"
        }
    ]
  }
